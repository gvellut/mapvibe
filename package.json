{
    "name": "mapvibe",
    "version": "1.0.0",
    "description": "A static map interface component for embedding in blog posts or websites, as a Google My Maps replacement",
    "type": "module",
    "main": "./dist/mapvibe.cjs",
    "module": "./dist/mapvibe.mjs",
    "types": "./dist/lib.d.ts",
    "exports": {
        ".": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/mapvibe.mjs",
            "require": "./dist/mapvibe.cjs"
        },
        "./style.css": "./dist/mapvibe.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.ts",
        "lint": "oxlint src",
        "lint:fix": "oxlint --fix src",
        "fmt": "oxfmt src",
        "fmt:check": "oxfmt --check src",
        "build": "tsc && vite build",
        "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
        "preview": "vite preview",
        "copy-dist": "dotenv -e .env -- sh -c 'rsync -av --delete dist/ $BLOG_STATIC_FOLDER'",
        "prepublishOnly": "npm run build:lib"
    },
    "keywords": [
        "map",
        "maplibre",
        "react",
        "typescript",
        "geospatial",
        "interactive-map",
        "embed"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gvellut/mapvibe.git"
    },
    "peerDependencies": {
        "maplibre-gl": "^6.11.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "dotenv-cli": "^11.0.0",
        "maplibre-gl": "^6.11.2",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sass": "^1.105.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.1"
    }
}
